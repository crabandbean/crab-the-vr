{
  "name": "Crab the VR",
  "controller_type": "vive_controller",
  "bindings": {
    "/actions/joyvr/in/trigger_use": {
      "sources": [
        {
          "path": "/user/hand/left/input/trigger/click"
        },
        {
          "path": "/user/hand/right/input/trigger/click"
        }
      ]
    },
    "/actions/joyvr/in/grip_grab": {
      "sources": [
        {
          "path": "/user/hand/left/input/grip/click"
        },
        {
          "path": "/user/hand/right/input/grip/click"
        }
      ]
    },
    "/actions/joyvr/in/menu": {
      "sources": [
        {
          "path": "/user/hand/left/input/application_menu/click"
        },
        {
          "path": "/user/hand/right/input/application_menu/click"
        }
      ]
    },
    "/actions/joyvr/in/trackpad_move": {
      "sources": [
        {
          "path": "/user/hand/left/input/trackpad"
        },
        {
          "path": "/user/hand/right/input/trackpad"
        }
      ]
    },
    "/actions/joyvr/out/haptic": {
      "sources": [
        {
          "path": "/user/hand/left/output/haptic"
        },
        {
          "path": "/user/hand/right/output/haptic"
        }
      ]
    }
  }
}
